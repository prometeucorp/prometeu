{
  "name": "prometeu",
  "private": true,
  "version": "0.24.0",
  "type": "module",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": "24.14.0",
    "npm": "11.9.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit && tsc -p relay && tsc -p packages/design-system --noEmit",
    "build": "npm run design-system:build && npm run typecheck && vite build",
    "app": "sh scripts/app.sh",
    "app:bundle": "sh scripts/app-bundle.sh",
    "build:app": "tauri build",
    "build:mobile": "vite build --config vite.mobile.config.ts",
    "tauri": "tauri",
    "test": "npm run test:release && npm run test:web && npm run test:rust && npm run test:e2e",
    "test:release": "python3 scripts/test_release.py",
    "test:web": "vitest run",
    "test:contracts": "node scripts/check-contracts.mjs && vitest run src/backend-contract.test.ts src/conversation.test.ts",
    "contracts:update": "node scripts/update-contracts.mjs",
    "test:e2e": "playwright test",
    "test:rust": "cd src-tauri && cargo test --workspace --all-targets",
    "test:runtime": "cd src-tauri && cargo test -p prometeu-runtime -p prometeu-protocols --locked",
    "test:core": "cd src-tauri && cargo test -p prometeu-core --locked",
    "test:tools": "cd src-tauri && cargo test -p prometeu-tools --locked",
    "test:profiles": "cd src-tauri && cargo test -p prometeu-profiles --locked",
    "test:process": "cd src-tauri && cargo test -p prometeu-process --locked",
    "docs:check": "node scripts/check-docs.mjs",
    "architecture:check": "node --test scripts/architecture-dependencies.test.mjs && node scripts/check-architecture.mjs",
    "format:check": "cd src-tauri && cargo fmt --all -- --check",
    "lint:rust": "cd src-tauri && cargo clippy --workspace --all-targets --all-features -- -D warnings",
    "check": "npm run docs:check && npm run architecture:check && npm run format:check && npm run build && npm run build:wsl && npm run test:contracts && npm run build:mobile && npm test && npm run lint:rust",
    "prepare": "node scripts/install-hooks.mjs",
    "relay:dev": "wrangler dev --config relay/wrangler.toml --port 8787",
    "relay:deploy": "wrangler deploy --config relay/wrangler.toml",
    "design-system:build": "npm run build --prefix packages/design-system",
    "predev": "npm run design-system:build",
    "build:feedback": "vite build --config vite.feedback.config.ts",
    "dev:wsl": "vite --config vite.wsl.config.ts",
    "build:wsl": "npm run design-system:build && npm run typecheck && vite build --config vite.wsl.config.ts",
    "app:wsl": "node scripts/wsl-app.mjs dev",
    "build:app:wsl": "node scripts/wsl-app.mjs build --no-bundle",
    "package:windows": "node scripts/wsl-app.mjs build --bundles nsis",
    "test:windows:native": "node scripts/test-windows-application.mjs",
    "test:bridge": "cd src-tauri && cargo test -p prometeu-bridge --locked"
  },
  "dependencies": {
    "@hpke/core": "1.9.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "marked": "^18.0.11"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260826.1",
    "@playwright/test": "1.62.1",
    "@tauri-apps/cli": "^2",
    "@types/node": "^24.13.3",
    "git-cliff": "^2.13.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "4.1.11",
    "wrangler": "^4.126.0"
  }
}
